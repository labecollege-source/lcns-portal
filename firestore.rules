rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public readable CMS & website info
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /officers/{officerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /programmes/{programmeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{imageId} {
      allow read: if true;
      // Portal authentication is implemented in the application layer.
      // Gallery metadata therefore remains writable for the connected Media Center.
      allow write: if true;
    }

    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // User management
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Applicants
    match /applicants/{applicantId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // Students
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Academic setup
    match /academic_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /courses/{courseId} {
      allow read: if true;
      // Course creation/assignment is exposed only in the Registrar, Exam Officer
      // and ICT interfaces, with role checks handled by the portal UI.
      allow write: if true;
    }

    match /course_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /course_registrations/{regId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Examination & Results
    match /results/{resultId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /ca_scores/{scoreId} {
      allow read, write: if isAuthenticated();
    }

    match /exam_scores/{scoreId} {
      allow read, write: if isAuthenticated();
    }

    match /carryovers/{carryoverId} {
      allow read, write: if isAuthenticated();
    }

    // CBT Exams
    match /cbt_exams/{examId} {
      allow read, write: if isAuthenticated();
    }

    match /cbt_attempts/{attemptId} {
      allow read, write: if isAuthenticated();
    }

    // Bursary & Payments
    match /fee_structures/{feeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Audit logs - append-only, immutable
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if false;
    }

    // System settings
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
